<Window x:Class="Pantry_To_Plate.windows.PantryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:Pantry_To_Plate.windows" xmlns:uc="clr-namespace:Pantry_To_Plate.UserControls" mc:Ignorable="d" Title="Pantry / Vorratsliste" Height="720" Width="1430" MinHeight="680" MinWidth="1350" WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="#FFF7F7FA" FontFamily="Segoe UI">

    <Window.Resources>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#EB477B"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#D83E70"/>
        <SolidColorBrush x:Key="TextBrush" Color="#24242A"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#777783"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#FFE8E8EE"/>
        <SolidColorBrush x:Key="SoftPinkBrush" Color="#FFFFF4F8"/>
        <SolidColorBrush x:Key="SoftGreenBrush" Color="#FFEAF8EE"/>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SoftPinkBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#FFFFC8D7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFFFE8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFDFDFE"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#FFE4E4EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFFFF4F8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFFFE6EF"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFDFDFE"/>
            <Setter Property="BorderBrush" Value="#FFCBEBD4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FFF7FCF8"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFEAF8EE"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>
    <Grid Background="#FFF7F7FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <uc:Sidebar Grid.Column="0" ActivePage="Pantry"/>

        <Border Grid.Column="1" Background="#FFF7F7FA">
            <Grid Margin="32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="White" CornerRadius="24" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="26,22" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Pantry / Vorratsliste" FontSize="34" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Vorhandene Lebensmittel suchen, Mengen eintragen und später für Rezeptvorschläge verwenden." FontSize="14" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#FFFFF4F8" CornerRadius="16" Padding="16,10" VerticalAlignment="Center">
                                <TextBlock Text="Pantry to Plate" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="22">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Lebensmittel hinzufügen" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="Suche Lebensmittel und trage die Menge ein." FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                                </StackPanel>

                                <Border Grid.Row="1" Background="#FFFDFDFE" CornerRadius="14" BorderBrush="#FFE4E4EA" BorderThickness="1" Margin="0,18,0,12">
                                    <TextBox x:Name="TxtSearch" Height="40" BorderThickness="0" TextChanged="TxtSearch_TextChanged"/>
                                </Border>

                                <Border Grid.Row="2" Background="#FFFDFDFE" CornerRadius="18" BorderBrush="#FFF0F0F5" BorderThickness="1" Padding="8">
                                    <ListBox x:Name="ListBoxFoods" FontSize="14" SelectionChanged="ListBoxFoods_SelectionChanged"/>
                                </Border>

                                <Border Grid.Row="3" Background="#FFFFF9FB" CornerRadius="18" BorderBrush="#FFFFD6E1" BorderThickness="1" Padding="16" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Menge in Gramm" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBox x:Name="TxtAmount" Height="38" Margin="0,8,0,14" FontSize="15"/>
                                        <Button Content="Zum Pantry hinzufügen" Style="{StaticResource PrimaryButton}" Click="AddToPantry_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="22">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Vorhandene Lebensmittel" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="Alle aktuell gespeicherten Vorräte auf einen Blick." FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="#FFEAF8EE" CornerRadius="14" Padding="14,8" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSummary" FontSize="13" FontWeight="SemiBold" Foreground="#648C58" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="1" Background="{StaticResource SoftGreenBrush}" CornerRadius="20" BorderBrush="#FFCBEBD4" BorderThickness="1" Padding="0" Margin="0,18,0,18">
                                    <DataGrid x:Name="DataGridPantry" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Lebensmittel" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="Menge (g)" Binding="{Binding AmountInGram, StringFormat=F0}" Width="120"/>
                                            <DataGridTextColumn Header="Kalorien" Binding="{Binding Calories, StringFormat=F0}" Width="120"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Ausgewähltes löschen" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Click="DeleteSelected_Click"/>
                                    <Button Content="Schließen" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
                                </StackPanel>
                                <Button Content="Sortierung: älteste" Name="BtnFiltern" Click="BtnFiltern_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="107,0,0,0" Grid.Row="2" VerticalAlignment="Center" Height="30" Width="185"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
        </Border>
    </Grid>
</Window>
