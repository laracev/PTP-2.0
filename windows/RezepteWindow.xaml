<Window x:Class="Pantry_To_Plate.windows.RezepteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Rezepte" Height="841" Width="1180" MinHeight="720" MinWidth="1100" WindowStartupLocation="CenterOwner" Background="#FFF7F7FA" FontFamily="Segoe UI">
    <Window.Resources>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#EB477B"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#D83E70"/>
        <SolidColorBrush x:Key="TextBrush" Color="#24242A"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#777783"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#FFE8E8EE"/>
        <SolidColorBrush x:Key="SoftPinkBrush" Color="#FFFFF4F8"/>
        <SolidColorBrush x:Key="SoftGreenBrush" Color="#FFEAF8EE"/>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SoftPinkBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#FFFFC8D7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFFFE8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFFFF4F8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFFFE6EF"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFF7FA"/>
            <Setter Property="BorderBrush" Value="#FFFFD6E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FFFFF9FB"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFFFEEF4"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="24" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="26,22" Margin="0,0,0,17">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Rezepte und Vorschläge" FontSize="34" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Rezepte werden danach sortiert, wie viele Zutaten du bereits im Pantry hast." FontSize="14" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#FFFFF4F8" CornerRadius="16" Padding="16,10" VerticalAlignment="Center">
                    <TextBlock Text="Pantry to Plate" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Rezeptvorschläge" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Wähle ein Rezept aus der Liste." FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#FFFDFDFE" CornerRadius="18" BorderBrush="#FFF0F0F5" BorderThickness="1" Padding="8" Margin="0,18,0,18">
                        <ListBox x:Name="ListBoxRecipes" FontSize="14" SelectionChanged="ListBoxRecipes_SelectionChanged"/>
                    </Border>

                    <Button Grid.Row="2" Content="Schließen" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="26" Margin="0,0,0,-25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="190"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="TxtRecipeName" Text="Bitte Rezept auswählen" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Height="32"/>
                        <TextBlock x:Name="TxtRecipeDescription" FontSize="14" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtRecipeMatch" FontSize="15" Foreground="#648C58" FontWeight="SemiBold" Margin="0,10,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,24,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Zutaten" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Grid.Column="2" Text="Fehlende Zutaten" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#FFFFF7FA" CornerRadius="18" BorderBrush="#FFFFD6E1" BorderThickness="1" Padding="0">
                            <DataGrid x:Name="DataGridIngredients" AutoGenerateColumns="False" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Lebensmittel" Binding="{Binding FoodName}" Width="*"/>
                                    <DataGridTextColumn Header="Menge (g)" Binding="{Binding AmountGram, StringFormat=F0}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource SoftGreenBrush}" CornerRadius="18" BorderBrush="#FFCBEBD4" BorderThickness="1" Padding="8">
                            <ListBox x:Name="ListBoxMissing" FontSize="14" Background="Transparent"/>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Background="#FFFFF9FB" CornerRadius="20" BorderBrush="#FFFFC8D7" BorderThickness="1" Padding="18" Margin="0,189,0,10" Grid.RowSpan="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Zubereitung" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="TxtPreparation" TextWrapping="Wrap" FontSize="15" LineHeight="24" Foreground="#34343A"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Fehlendes zur Einkaufsliste" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Click="AddMissingToShoppingList_Click"/>
                        <Button Content="Rezept nachkochen" Style="{StaticResource PrimaryButton}" Click="CookRecipe_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>