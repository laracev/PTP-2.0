<UserControl x:Class="Pantry_To_Plate.UserControls.Sidebar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="Auto" Width="290" Background="White">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#EB477B"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFFFF4F8"/>
        <SolidColorBrush x:Key="AccentBorderBrush" Color="#FFFFC8D7"/>
        <SolidColorBrush x:Key="TextDarkBrush" Color="#24242A"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#777783"/>
        <DropShadowEffect x:Key="SidebarShadow" Color="#18000000" BlurRadius="26" ShadowDepth="2" Opacity="0.22"/>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="20,5"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#FFF9F0F4"/>
                                <Setter Property="Foreground" Value="#EB477B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#FFFFE8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
    </UserControl.Resources>

    <Border Background="White" Effect="{StaticResource SidebarShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="20,26,20,28" HorizontalAlignment="Center">
                <Grid Width="148" Height="147" Margin="0,0,0,8">
                    <Image Source="pack://siteoforigin:,,,/pictures/Screenshot 2026-05-07 134630.png" Margin="0,0,2,1"/>
                </Grid>
                <TextBlock Text="Pantry To Plate" FontSize="23" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Dein smarter Food- und Fitnessbegleiter" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <Button x:Name="BtnHome" Content="Home" Click="Home_Click" Style="{StaticResource NavButtonStyle}"/>
                <Button x:Name="BtnPantry" Content="Pantry" Click="Pantry_Click" Style="{StaticResource NavButtonStyle}"/>
                <Button x:Name="BtnRecipes" Content="Rezepte" Click="Recipes_Click" Style="{StaticResource NavButtonStyle}"/>
                <Button x:Name="BtnMeals" Content="Mahlzeiten" Click="Meals_Click" Style="{StaticResource NavButtonStyle}"/>
                <Button x:Name="BtnShopping" Content="Einkaufsliste" Click="Shopping_Click" Style="{StaticResource NavButtonStyle}"/>
                <Button x:Name="BtnFitness" Content="Fitness" Click="Fitness_Click" Style="{StaticResource NavButtonStyle}"/>
                <Button x:Name="BtnSettings" Content="Einstellungen" Click="Settings_Click" Style="{StaticResource NavButtonStyle}"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="18" Margin="22,20,22,28">
                <StackPanel>
                    <TextBlock Text="Tipp des Tages" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Plane deine Mahlzeiten aus dem, was du bereits im Pantry hast." FontSize="12" Foreground="#565667" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
